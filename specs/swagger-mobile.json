{
    "openapi": "3.0.3",
    "info": {
        "title": "TaoPulse API",
        "version": "0.1.0"
    },
    "paths": {
        "/api/auth/token/login/": {
            "post": {
                "operationId": "auth_token_login_create",
                "description": "Authenticate a user and return a JWT access/refresh pair.",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequestRequestDto"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenPairResponseDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/token/refresh/": {
            "post": {
                "operationId": "auth_token_refresh_create",
                "description": "Exchange a valid refresh token for a new access token.",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRefreshRequestDto"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenRefreshDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/health/": {
            "get": {
                "operationId": "health_check",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponseDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/subnets/": {
            "get": {
                "operationId": "list_subnets",
                "description": "Public subnet list: identity + metrics slice. Fixture-backed, no DB.\n\nSupports ``?q=`` (search) and ``?sort=``. When the request is authenticated,\neach row's ``is_saved`` reflects the user's saved set. See subnet_list.md.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Case-insensitive substring match on name + tagline."
                    },
                    {
                        "in": "query",
                        "name": "sort",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "emission",
                                "market_cap",
                                "price_change_24h",
                                "volume_24h"
                            ]
                        },
                        "description": "Metric to sort by, descending. Default market_cap."
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/SubnetListItemDto"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/subnets/{netuid}/": {
            "get": {
                "operationId": "get_subnet",
                "description": "Evergreen subnet header: identity + links + lore (+ per-user is_saved).\n\nFetched once per detail open; the perishable Stats/Pulse tabs are separate,\npollable endpoints. No database — see subnet_detail.md.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "netuid",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SubnetAboutDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/subnets/{netuid}/pulse/": {
            "get": {
                "operationId": "get_subnet_pulse",
                "description": "Perishable pulse feed (digest + signals) for the Pulse tab.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "netuid",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SubnetPulseDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/subnets/{netuid}/saved/": {
            "put": {
                "operationId": "save_subnet",
                "description": "Save/unsave a subnet for the current user. Auth required, idempotent.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "netuid",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SubnetSavedStateDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "delete": {
                "operationId": "unsave_subnet",
                "description": "Save/unsave a subnet for the current user. Auth required, idempotent.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "netuid",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/subnets/{netuid}/stats/": {
            "get": {
                "operationId": "get_subnet_stats",
                "description": "Perishable metrics for the Stats tab (hero + financial + network + roster).\n\nPoll this to refresh; the evergreen header is fetched separately.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "netuid",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SubnetStatsDto"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/subnets/saved/": {
            "get": {
                "operationId": "list_saved_subnets",
                "description": "The current user's saved subnets, as full list rows. Auth required.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Case-insensitive substring match on name + tagline."
                    },
                    {
                        "in": "query",
                        "name": "sort",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "emission",
                                "market_cap",
                                "price_change_24h",
                                "volume_24h"
                            ]
                        },
                        "description": "Metric to sort by, descending. Default market_cap."
                    }
                ],
                "tags": [
                    "subnets"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/SubnetListItemDto"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HealthResponseDto": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "service": {
                        "type": "string"
                    }
                },
                "required": [
                    "service",
                    "status"
                ]
            },
            "LoginRequestRequestDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "SubnetAboutDto": {
                "type": "object",
                "description": "Evergreen subnet header: identity + links + lore + per-user is_saved.",
                "properties": {
                    "netuid": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "symbol": {
                        "type": "string"
                    },
                    "logo_url": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "is_verified": {
                        "type": "boolean"
                    },
                    "is_saved": {
                        "type": "boolean"
                    },
                    "tagline": {
                        "type": "string",
                        "nullable": true
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "links": {
                        "$ref": "#/components/schemas/SubnetLinksDto"
                    },
                    "lore": {
                        "$ref": "#/components/schemas/SubnetLoreDto"
                    }
                },
                "required": [
                    "categories",
                    "is_saved",
                    "is_verified",
                    "links",
                    "logo_url",
                    "lore",
                    "name",
                    "netuid",
                    "status",
                    "symbol",
                    "tagline"
                ]
            },
            "SubnetLinksDto": {
                "type": "object",
                "properties": {
                    "website": {
                        "type": "string",
                        "nullable": true
                    },
                    "github": {
                        "type": "string",
                        "nullable": true
                    },
                    "subnet_url": {
                        "type": "string",
                        "nullable": true
                    },
                    "discord": {
                        "type": "string",
                        "nullable": true
                    },
                    "contact_email": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "contact_email",
                    "discord",
                    "github",
                    "subnet_url",
                    "website"
                ]
            },
            "SubnetListItemDto": {
                "type": "object",
                "description": "One subnet list row: identity + a small metrics slice + saved state.\n\nFixture-backed read contract (no model). See subnet_list.md.",
                "properties": {
                    "netuid": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "symbol": {
                        "type": "string"
                    },
                    "logo_url": {
                        "type": "string"
                    },
                    "tagline": {
                        "type": "string",
                        "nullable": true
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "status": {
                        "type": "string"
                    },
                    "is_verified": {
                        "type": "boolean"
                    },
                    "is_saved": {
                        "type": "boolean"
                    },
                    "metrics": {
                        "$ref": "#/components/schemas/SubnetListMetricsDto"
                    }
                },
                "required": [
                    "categories",
                    "is_saved",
                    "is_verified",
                    "logo_url",
                    "metrics",
                    "name",
                    "netuid",
                    "status",
                    "symbol",
                    "tagline"
                ]
            },
            "SubnetListMetricsDto": {
                "type": "object",
                "description": "The small perishable slice shown on a subnet list row.",
                "properties": {
                    "price": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "price_change_24h": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "market_cap": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "volume_24h": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "emission": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    }
                },
                "required": [
                    "emission",
                    "market_cap",
                    "price",
                    "price_change_24h",
                    "volume_24h"
                ]
            },
            "SubnetLoreDto": {
                "type": "object",
                "description": "subnetradar research object, keys verbatim (see subnet_identity.md).",
                "properties": {
                    "tagline": {
                        "type": "string",
                        "nullable": true
                    },
                    "mission": {
                        "type": "string",
                        "nullable": true
                    },
                    "mechanism": {
                        "type": "string",
                        "nullable": true
                    },
                    "team": {
                        "type": "string",
                        "nullable": true
                    },
                    "useCase": {
                        "type": "string",
                        "nullable": true
                    },
                    "riskNote": {
                        "type": "string",
                        "nullable": true
                    },
                    "story": {
                        "type": "string",
                        "nullable": true
                    },
                    "competesWith": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "verified": {
                        "type": "boolean"
                    }
                }
            },
            "SubnetPulseDigestDto": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string"
                    },
                    "sentiment": {
                        "type": "integer",
                        "nullable": true
                    },
                    "health": {
                        "type": "integer",
                        "nullable": true
                    },
                    "net_flow_7d": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "required": [
                    "health",
                    "net_flow_7d",
                    "sentiment",
                    "summary"
                ]
            },
            "SubnetPulseDto": {
                "type": "object",
                "properties": {
                    "digest": {
                        "$ref": "#/components/schemas/SubnetPulseDigestDto"
                    },
                    "signals": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SubnetPulseSignalDto"
                        }
                    }
                },
                "required": [
                    "digest",
                    "signals"
                ]
            },
            "SubnetPulseSignalDto": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "time": {
                        "type": "string"
                    },
                    "tone": {
                        "type": "string"
                    },
                    "headline": {
                        "type": "string"
                    },
                    "delta": {
                        "type": "string"
                    },
                    "quote": {
                        "type": "string"
                    }
                },
                "required": [
                    "delta",
                    "headline",
                    "time",
                    "tone",
                    "type"
                ]
            },
            "SubnetSavedStateDto": {
                "type": "object",
                "description": "Response for the per-subnet save toggle (PUT).",
                "properties": {
                    "netuid": {
                        "type": "integer"
                    },
                    "is_saved": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "is_saved",
                    "netuid"
                ]
            },
            "SubnetStatsDto": {
                "type": "object",
                "description": "The full subnet_metrics record — the Stats tab. See subnet_metrics.md.",
                "properties": {
                    "netuid": {
                        "type": "integer"
                    },
                    "price": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "price_usd": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "price_change_24h": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "price_change_7d": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "health": {
                        "type": "integer",
                        "nullable": true
                    },
                    "market_cap": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "volume_24h": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "liquidity": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "token_supply": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "emissions_per_day": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "owner_per_day": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "miner_per_day": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "validator_per_day": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "network_share": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "root_proportion": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "tao_locked": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "incentive_burn": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "uids_active": {
                        "type": "integer",
                        "nullable": true
                    },
                    "uids_max": {
                        "type": "integer",
                        "nullable": true
                    },
                    "reg_cost": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "price_series": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "number",
                                "format": "double"
                            }
                        }
                    },
                    "top_miners": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SubnetTopMinerDto"
                        }
                    },
                    "updated_at": {
                        "type": "string"
                    }
                },
                "required": [
                    "emissions_per_day",
                    "health",
                    "incentive_burn",
                    "liquidity",
                    "market_cap",
                    "miner_per_day",
                    "netuid",
                    "network_share",
                    "owner_per_day",
                    "price",
                    "price_change_24h",
                    "price_change_7d",
                    "price_series",
                    "price_usd",
                    "reg_cost",
                    "root_proportion",
                    "tao_locked",
                    "token_supply",
                    "top_miners",
                    "uids_active",
                    "uids_max",
                    "updated_at",
                    "validator_per_day",
                    "volume_24h"
                ]
            },
            "SubnetTopMinerDto": {
                "type": "object",
                "properties": {
                    "uid": {
                        "type": "integer"
                    },
                    "hotkey": {
                        "type": "string"
                    },
                    "score": {
                        "type": "integer",
                        "nullable": true
                    },
                    "reward_per_day": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    }
                },
                "required": [
                    "hotkey",
                    "reward_per_day",
                    "score",
                    "uid"
                ]
            },
            "TokenPairResponseDto": {
                "type": "object",
                "description": "JWT issued to mobile clients on login.",
                "properties": {
                    "access": {
                        "type": "string"
                    },
                    "refresh": {
                        "type": "string"
                    },
                    "user": {
                        "$ref": "#/components/schemas/UserDto"
                    }
                },
                "required": [
                    "access",
                    "refresh",
                    "user"
                ]
            },
            "TokenRefreshDto": {
                "type": "object",
                "properties": {
                    "access": {
                        "type": "string",
                        "readOnly": true
                    }
                },
                "required": [
                    "access"
                ]
            },
            "TokenRefreshRequestDto": {
                "type": "object",
                "properties": {
                    "refresh": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "refresh"
                ]
            },
            "UserDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "username": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "email",
                    "id",
                    "username"
                ]
            }
        }
    },
    "servers": [
        {
            "url": "/taopulse"
        }
    ]
}